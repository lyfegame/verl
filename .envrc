# .envrc file for automatic environment activation
# If you have direnv installed, this will automatically activate the correct environment

# Check if the verl_fixed environment exists
if conda info --envs | grep -q "verl_fixed"; then
    # Source conda and activate the environment
    source ~/anaconda3/etc/profile.d/conda.sh
    conda activate verl_fixed
    
    # Add current directory to PYTHONPATH
    export PYTHONPATH="$PWD:$PYTHONPATH"
    
    echo "Auto-activated VERL environment: verl_fixed"
else
    echo "VERL environment not found. Run './setup_env.sh' to create it."
fi 